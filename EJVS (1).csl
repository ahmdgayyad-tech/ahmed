<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US">

  <info>
    <title>Egyptian Journal of Veterinary Sciences (EJVS)</title>
    <title-short>EJVS</title-short>
    <id>http://www.zotero.org/styles/custom-ejvs</id>
    <link href="http://www.zotero.org/styles/custom-ejvs" rel="self"/>
    <category citation-format="numeric"/>
    <category field="biology"/>
    <summary>Egyptian Journal of Veterinary Sciences custom numeric citation style.</summary>
    <updated>2026-10-08T00:00:00+00:00</updated>
  </info>

  <!-- =========================
       AUTHORS
       ========================= -->

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with="."
            delimiter=", "
            delimiter-precedes-last="never"
            and="text"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all"
                sort-separator=", "
                initialize-with="."
                delimiter=", "
                delimiter-precedes-last="never"
                and="text"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>


  <!-- =========================
       ARTICLE TITLE
       ========================= -->

  <macro name="title">
    <text variable="title" suffix="."/>
  </macro>


  <!-- =========================
       YEAR
       ========================= -->

  <macro name="year">
    <date variable="issued" prefix="(" suffix=")">
      <date-part name="year"/>
    </date>
  </macro>


  <!-- =========================
       DOI
       No final punctuation
       ========================= -->

  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix=" DOI: "/>
      </if>
    </choose>
  </macro>


  <!-- =========================
       PUBLISHER
       ========================= -->

  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>


  <!-- =========================
       PAGES
       ========================= -->

  <macro name="pages">
    <text variable="page"/>
  </macro>


  <!-- =========================
       IN-TEXT CITATIONS
       Examples:
       [1]
       [1–3]
       [1, 3, 4]
       ========================= -->

  <citation collapse="citation-number"
            after-collapse-delimiter=", "
            cite-group-delimiter=", "
            range-delimiter="–">

    <sort>
      <key variable="citation-number"/>
    </sort>

    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>

  </citation>


  <!-- =========================
       BIBLIOGRAPHY
       ========================= -->

  <bibliography entry-spacing="0"
                second-field-align="flush">

    <sort>
      <key variable="citation-number"/>
    </sort>

    <!--
      IMPORTANT:
      No suffix="." here.
      This prevents a final period after DOI.
    -->

    <layout>

      <text variable="citation-number" suffix=". "/>

      <choose>

        <!-- =========================
             JOURNAL ARTICLE
             ========================= -->

        <if type="article-journal article-magazine article-newspaper"
            match="any">

          <text macro="author" suffix=". "/>

          <text macro="title" suffix=" "/>

          <text variable="container-title"
                font-style="italic"
                suffix=", "/>

          <group suffix=", ">

            <text variable="volume"
                  font-weight="bold"/>

            <text variable="issue"
                  prefix="("
                  suffix=")"/>

          </group>

          <text macro="pages"
                suffix=" "/>

          <!--
            The period after the year is intentional.
            Therefore:
            (2024). DOI: ...
          -->

          <text macro="year"
                suffix="."/>

          <!--
            DOI has NO final period.
          -->

          <text macro="doi"/>

        </if>


        <!-- =========================
             BOOK
             ========================= -->

        <else-if type="book"
                 match="any">

          <text macro="author"
                suffix=". "/>

          <text variable="title"
                font-style="italic"
                suffix=". "/>

          <text macro="publisher"
                suffix=". "/>

          <text macro="year"
                suffix="."/>

          <text variable="page"
                prefix=" pp. "
                suffix="."/>

          <text macro="doi"/>

        </else-if>


        <!-- =========================
             BOOK CHAPTER
             ========================= -->

        <else-if type="chapter"
                 match="any">

          <text macro="author"
                suffix=". "/>

          <text variable="title"
                suffix=". "/>

          <text value="In: "/>

          <names variable="editor"
                 suffix=". ">

            <name name-as-sort-order="all"
                  sort-separator=", "
                  initialize-with="."
                  delimiter=", "
                  delimiter-precedes-last="never"
                  and="text"/>

          </names>

          <text variable="container-title"
                font-style="italic"
                suffix=". "/>

          <text macro="publisher"
                suffix=". "/>

          <text variable="page"
                prefix="pp. "
                suffix=" "/>

          <text macro="year"
                suffix="."/>

          <text macro="doi"/>

        </else-if>


        <!-- =========================
             THESIS
             ========================= -->

        <else-if type="thesis"
                 match="any">

          <text macro="author"
                suffix=". "/>

          <text variable="title"
                suffix=". "/>

          <text variable="genre"
                suffix=". "/>

          <text variable="publisher"
                suffix=". "/>

          <text macro="year"
                suffix="."/>

        </else-if>


        <!-- =========================
             OTHER TYPES / WEBSITE
             ========================= -->

        <else>

          <text macro="author"
                suffix=". "/>

          <text variable="title"
                suffix=". "/>

          <text variable="container-title"
                font-style="italic"
                suffix=", "/>

          <text macro="year"
                suffix="."/>

          <text macro="doi"/>

          <text variable="URL"
                prefix=" Available at: "/>

        </else>

      </choose>

    </layout>

  </bibliography>

</style>
